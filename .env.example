# Copie este arquivo para ".env" e preencha com os SEUS dados.
# O arquivo .env de verdade NUNCA deve ser enviado para o GitHub.

# Suas credenciais do Telegram (pegue em https://my.telegram.org/apps)
ID_API=
API_HASH=

# Opcionais (se deixar em branco, o programa pergunta no terminal
# ou usa o padrão indicado)
# DESTINO=                # grupo/canal/conversa padrão (título, @, link ou ID)
# PASTA_VIDEOS=           # padrão: ~/Vídeos
# LIMITE_MENSAGENS=       # padrão: todas as mensagens acessíveis
# NOME_SESSAO=captura_videos
